# Payment Gateways
STRIPE_API_KEY=your_stripe_secret_key_here

# Notifications & Messaging
RESEND_API_KEY=your_resend_api_key_here
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE=your_twilio_phone_number_here

# Database Configuration (Privileged / DDL)
DDL_DB_USER=your_ddl_db_user_here
DDL_USER_PASSWORD=your_ddl_user_password_here

# Database Configuration (Application / DML)
DML_DB_USER=your_dml_db_user_here
DML_USER_PASSWORD=your_dml_user_password_here

DB_HOST=localhost
DB_PORT=5432
DB_NAME=your_database_name_here

# Security & JWT
JWT_SECRET_KEY=your_super_secret_jwt_key_here
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here
VITE_GOOGLE_CLIENT_ID=your_vite_google_client_id_here