# En desarrollo, Vite redirige /backend al servidor FastAPI.
VITE_API_BASE_URL=/backend

# Destino del proxy de Vite (opcional; por defecto http://127.0.0.1:8000)
# VITE_BACKEND_TARGET=http://127.0.0.1:8000

# ID de cliente OAuth 2.0 de Google (debe coincidir con GOOGLE_CLIENT_ID del backend).
VITE_GOOGLE_CLIENT_ID=
